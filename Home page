<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f4f8fc" />

  <title>The Skin Edit — Skin Science, Simplified</title>
  <meta
    name="description"
    content="Explore evidence-informed skincare education, ingredient guides and simple routines with The Skin Edit."
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --navy: #173b62;
      --blue: #7399bd;
      --powder: #e4eef8;
      --pale: #f4f8fc;
      --white: #ffffff;
      --ink: #263b50;
      --muted: #6c7e90;
      --line: #dce6ef;
      --serif: "Playfair Display", Georgia, serif;
      --sans: "DM Sans", Arial, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 90px;
    }

    body {
      background: var(--pale);
      color: var(--ink);
      font-family: var(--sans);
      line-height: 1.7;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
      cursor: pointer;
    }

    .container {
      width: min(1120px, 90%);
      margin: 0 auto;
    }

    .announcement {
      background: var(--navy);
      color: white;
      text-align: center;
      padding: 8px 15px;
      font-size: 11px;
      letter-spacing: 1.6px;
      text-transform: uppercase;
    }

    header {
      background: rgba(244, 248, 252, 0.96);
      border-bottom: 1px solid var(--line);
      position: sticky;
      top: 0;
      z-index: 10;
      backdrop-filter: blur(14px);
    }

    .navbar {
      min-height: 82px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      color: var(--navy);
      flex-shrink: 0;
    }

    .brand-mark {
      width: 39px;
      height: 39px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: var(--navy);
      color: white;
      font-family: var(--serif);
      font-size: 23px;
    }

    .brand-name {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 2.5px;
      line-height: 1.3;
    }

    .brand-caption {
      font-size: 9px;
      letter-spacing: 2px;
      color: var(--muted);
    }

    nav {
      display: flex;
      align-items: center;
      gap: 27px;
      font-size: 13px;
      color: var(--ink);
    }

    nav a:hover,
    .text-link:hover {
      color: #527da5;
    }

    .nav-cta {
      border: 1px solid #b9cbdd;
      padding: 10px 16px;
      border-radius: 5px;
    }

    .menu-toggle {
      display: none;
      background: none;
      border: 0;
      color: var(--navy);
      font-size: 25px;
    }

    .hero {
      padding: 64px 0 76px;
      display: grid;
      grid-template-columns: 1fr 0.95fr;
      align-items: center;
      gap: 64px;
    }

    .eyebrow {
      text-transform: uppercase;
      color: #5f84a8;
      letter-spacing: 2.5px;
      font-size: 10px;
      font-weight: 700;
      margin-bottom: 20px;
    }

    h1, h2, h3 {
      font-family: var(--serif);
      font-weight: 400;
      color: var(--navy);
      line-height: 1.18;
    }

    h1 {
      font-size: clamp(43px, 5vw, 67px);
      letter-spacing: -1.8px;
      margin-bottom: 24px;
    }

    h1 em {
      color: #6f98bd;
      font-weight: 400;
    }

    .hero-copy {
      color: var(--muted);
      font-size: 15px;
      max-width: 440px;
      margin-bottom: 30px;
    }

    .button-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 5px;
      padding: 13px 19px;
      font-size: 13px;
      font-weight: 600;
      border: 1px solid var(--navy);
      transition: transform 0.2s, background 0.2s;
    }

    .button:hover {
      transform: translateY(-2px);
    }

    .button-primary {
      background: var(--navy);
      color: white;
    }

    .button-primary:hover {
      background: #254f78;
    }

    .button-secondary {
      color: var(--navy);
      border-color: #bdcede;
      background: transparent;
    }

    .trust-note {
      display: flex;
      align-items: center;
      gap: 9px;
      color: var(--muted);
      font-size: 11px;
      margin-top: 27px;
    }

    .trust-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      background: #79a5c8;
      border-radius: 50%;
    }

    .hero-art {
      min-height: 430px;
      border-radius: 180px 180px 8px 8px;
      background:
        radial-gradient(ellipse at 70% 25%, #ffffff 0%, transparent 38%),
        linear-gradient(145deg, #eaf3fb, #c9dced 65%, #9dbbd6);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }

    .orb {
      width: 245px;
      height: 310px;
      border-radius: 48% 48% 28% 28%;
      background:
        linear-gradient(115deg,
          rgba(255,255,255,0.95),
          rgba(230,241,250,0.6) 36%,
          rgba(112,154,190,0.45) 72%,
          rgba(255,255,255,0.8));
      border: 1px solid rgba(255,255,255,0.8);
      box-shadow: 25px 25px 65px rgba(48,85,120,0.15);
      transform: rotate(-8deg);
      display: grid;
      place-items: center;
      position: relative;
    }

    .orb::before {
      content: "";
      width: 130px;
      height: 180px;
      position: absolute;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.85);
      transform: rotate(30deg);
    }

    .orb-label {
      font-family: var(--serif);
      color: var(--navy);
      font-size: 27px;
      text-align: center;
      z-index: 1;
      transform: rotate(8deg);
      line-height: 1.25;
    }

    .orb-label small {
      display: block;
      font-family: var(--sans);
      font-size: 9px;
      letter-spacing: 3px;
      margin-top: 12px;
    }

    .art-caption {
      position: absolute;
      bottom: 25px;
      left: 25px;
      color: #365b7b;
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .intro-strip {
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      background: #edf4fa;
      padding: 20px 0;
    }

    .intro-strip .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .strip-item {
      color: #4e6c88;
      font-size: 11px;
      letter-spacing: 1.1px;
      text-transform: uppercase;
    }

    section.content-section {
      padding: 88px 0;
    }

    .section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 25px;
      margin-bottom: 35px;
    }

    .section-heading h2 {
      font-size: clamp(32px, 4vw, 45px);
      margin-bottom: 10px;
    }

    .section-heading p {
      color: var(--muted);
      font-size: 14px;
      max-width: 480px;
    }

    .text-link {
      color: var(--navy);
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .topic-card {
      background: white;
      border: 1px solid var(--line);
      border-radius: 7px;
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .topic-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 15px 35px rgba(23,59,98,0.07);
    }

    .card-visual {
      height: 170px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, #e4eef8, #c9dceb);
      color: var(--navy);
      font-family: var(--serif);
      font-size: 44px;
    }

    .topic-card:nth-child(2) .card-visual {
      background: linear-gradient(135deg, #edf2f7, #d5e0eb);
    }

    .topic-card:nth-child(3) .card-visual {
      background: linear-gradient(135deg, #d8e8f4, #b8d1e5);
    }

    .card-body {
      padding: 23px;
    }

    .card-tag {
      color: #6b91b4;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1.8px;
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .card-body h3 {
      font-size: 23px;
      margin-bottom: 11px;
    }

    .card-body p {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 20px;
    }

    .card-action {
      color: var(--navy);
      font-size: 12px;
      font-weight: 700;
    }

    .feature {
      background: #e7f0f8;
      padding: 72px 0;
    }

    .feature-inner {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      align-items: center;
      gap: 65px;
    }

    .feature-symbol {
      min-height: 300px;
      display: grid;
      place-items: center;
      background: linear-gradient(140deg, #d4e5f3, #a8c5dd);
      border-radius: 8px;
      position: relative;
      overflow: hidden;
    }

    .feature-symbol::before,
    .feature-symbol::after {
      content: "";
      position: absolute;
      border: 1px solid rgba(255,255,255,0.8);
      border-radius: 50%;
    }

    .feature-symbol::before {
      width: 230px;
      height: 230px;
    }

    .feature-symbol::after {
      width: 165px;
      height: 165px;
    }

    .feature-symbol span {
      font-family: var(--serif);
      font-size: 66px;
      color: var(--navy);
      z-index: 1;
    }

    .feature h2 {
      font-size: clamp(34px, 4vw, 47px);
      margin-bottom: 18px;
    }

    .feature p {
      font-size: 14px;
      color: #61758a;
      margin-bottom: 24px;
      max-width: 480px;
    }

    .feature-list {
      list-style: none;
      display: grid;
      gap: 12px;
      margin-bottom: 28px;
      font-size: 13px;
      color: var(--ink);
    }

    .feature-list li::before {
      content: "✓";
      color: #628bb0;
      margin-right: 11px;
      font-weight: 700;
    }

    .newsletter {
      padding: 85px 0;
      text-align: center;
    }

    .newsletter h2 {
      font-size: clamp(34px, 4vw, 46px);
      margin-bottom: 15px;
    }

    .newsletter p {
      max-width: 470px;
      margin: 0 auto 25px;
      color: var(--muted);
      font-size: 14px;
    }

    .newsletter-form {
      display: flex;
      max-width: 450px;
      margin: 0 auto;
      gap: 8px;
    }

    .newsletter-form input {
      flex: 1;
      min-width: 0;
      padding: 13px;
      border: 1px solid #cbd9e6;
      border-radius: 5px;
      background: white;
      font: inherit;
      font-size: 13px;
    }

    .form-note {
      display: block;
      color: var(--muted);
      font-size: 10px;
      margin-top: 14px;
    }

    .form-message {
      color: var(--navy);
      margin-top: 15px;
      font-size: 13px;
    }

    footer {
      background: #17334f;
      color: #e8f0f7;
      padding: 45px 0 25px;
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      gap: 35px;
      flex-wrap: wrap;
      padding-bottom: 30px;
    }

    .footer-brand {
      font-family: var(--serif);
      font-size: 25px;
      margin-bottom: 10px;
    }

    .footer-description {
      color: #bacbda;
      max-width: 320px;
      font-size: 12px;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      font-size: 12px;
      align-items: start;
    }

    .footer-links a:hover {
      color: white;
      text-decoration: underline;
    }

    .footer-bottom {
      border-top: 1px solid rgba(255,255,255,0.17);
      padding-top: 20px;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 15px;
      color: #bacbda;
      font-size: 10px;
    }

    @media (max-width: 760px) {
      .navbar {
        min-height: 72px;
      }

      .menu-toggle {
        display: block;
      }

      nav {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        padding: 22px 5%;
        background: var(--pale);
        border-bottom: 1px solid var(--line);
        flex-direction: column;
        align-items: stretch;
        gap: 18px;
      }

      nav.open {
        display: flex;
      }

      .nav-cta {
        text-align: center;
      }

      .hero {
        grid-template-columns: 1fr;
        gap: 35px;
        padding: 48px 0 55px;
      }

      .hero-art {
        min-height: 330px;
        border-radius: 150px 150px 8px 8px;
      }

      .orb {
        width: 195px;
        height: 245px;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .card-visual {
        height: 150px;
      }

      .section-heading {
        align-items: start;
        flex-direction: column;
      }

      section.content-section {
        padding: 60px 0;
      }

      .feature-inner {
        grid-template-columns: 1fr;
        gap: 35px;
      }

      .feature-symbol {
        min-height: 240px;
      }

      .newsletter-form {
        flex-direction: column;
      }

      .newsletter-form .button {
        width: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *, *::before, *::after {
        transition: none !important;
      }
    }
  </style>
</head>

<body>
  <div class="announcement">
    SKIN SCIENCE, SIMPLIFIED — WELCOME TO THE SKIN EDIT
  </div>

  <header>
    <div class="container navbar">
      <a class="brand" href="#home" aria-label="The Skin Edit home">
        <span class="brand-mark">S</span>
        <span>
          <span class="brand-name">THE SKIN EDIT</span><br />
          <span class="brand-caption">SKIN SCIENCE, SIMPLIFIED.</span>
        </span>
      </a>

      <button
        class="menu-toggle"
        id="menuToggle"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="navigation"
      >☰</button>

      <nav id="navigation">
        <a href="#learn">Learn</a>
        <a href="#ingredients">Ingredients</a>
        <a href="#about">Our approach</a>
        <a class="nav-cta" href="#learn">Explore the edit ↗</a>
      </nav>
    </div>
  </header>

  <main id="home">
    <section class="container hero">
      <div>
        <p class="eyebrow">Your guide to understanding your skin</p>
        <h1>Good skin starts with <em>understanding.</em></h1>
        <p class="hero-copy">
          Skincare can feel overwhelming. We're here to make the
          science simpler, the ingredients clearer and your next
          steps easier to understand.
        </p>

        <div class="button-row">
          <a class="button button-primary" href="#learn">
            Explore skin science ↗
          </a>
          <a class="button button-secondary" href="#ingredients">
            Discover ingredients
          </a>
        </div>

        <p class="trust-note">
          <span class="trust-dot"></span>
          Education first. Evidence-informed. No skin shaming.
        </p>
      </div>

      <div class="hero-art" role="img"
        aria-label="Abstract icy blue and glass-inspired skincare artwork">
        <div class="orb">
          <div class="orb-label">
            The<br />Skin Edit
            <small>EST. IN SCIENCE</small>
          </div>
        </div>
        <span class="art-caption">A clearer view of skincare</span>
      </div>
    </section>

    <div class="intro-strip">
      <div class="container">
        <span class="strip-item">01 — Understand your skin</span>
        <span class="strip-item">02 — Learn your ingredients</span>
        <span class="strip-item">03 — Make informed choices</span>
      </div>
    </div>

    <section class="container content-section" id="learn">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The essentials</p>
          <h2>Your skin, decoded.</h2>
          <p>
            Start with the basics and explore skincare at your own pace.
            No complicated language required.
          </p>
        </div>
        <a class="text-link" href="#ingredients">
          Explore all topics ↗
        </a>
      </div>

      <div class="cards">
        <article class="topic-card">
          <div class="card-visual" aria-hidden="true">01</div>
          <div class="card-body">
            <p class="card-tag">Skin fundamentals</p>
            <h3>Know your skin</h3>
            <p>
              Explore the skin barrier, hydration and how skin works.
              Build your knowledge before building a routine.
            </p>
            <a class="card-action" href="#about">Start learning ↗</a>
          </div>
        </article>

        <article class="topic-card" id="ingredients">
          <div class="card-visual" aria-hidden="true">02</div>
          <div class="card-body">
            <p class="card-tag">Ingredient library</p>
            <h3>What's in your skincare?</h3>
            <p>
              Discover common skincare ingredients, what research
              says about them and what their labels actually mean.
            </p>
            <a class="card-action" href="#ingredient-guide">
              Explore ingredients ↗
            </a>
          </div>
        </article>

        <article class="topic-card">
          <div class="card-visual" aria-hidden="true">03</div>
          <div class="card-body">
            <p class="card-tag">Everyday skincare</p>
            <h3>Build the basics</h3>
            <p>
              Learn about gentle cleansing, moisturising, sun
              protection and keeping routines manageable.
            </p>
            <a class="card-action" href="#about">Discover the basics ↗</a>
          </div>
        </article>
      </div>
    </section>

    <section class="feature" id="ingredient-guide">
      <div class="container feature-inner">
        <div class="feature-symbol" aria-hidden="true">
          <span>02</span>
        </div>

        <div>
          <p class="eyebrow">The ingredient edit</p>
          <h2>Less guesswork.<br />More understanding.</h2>
          <p>
            Skincare labels can be confusing. Learn what common
            ingredients are, why they're used and which questions
            to ask before trying a new product.
          </p>

          <ul class="feature-list">
            <li>Plain-English ingredient explanations</li>
            <li>Evidence-informed educational guides</li>
            <li>Balanced information about benefits and limitations</li>
          </ul>

          <a class="button button-primary" href="#learn">
            Explore the library ↗
          </a>
        </div>
      </div>
    </section>

    <section class="container content-section" id="about">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Our philosophy</p>
          <h2>Skincare without the pressure.</h2>
          <p>
            Your skin doesn't need to be perfect. Our goal is to help
            you understand it and make informed, realistic choices.
          </p>
        </div>
      </div>

      <div class="cards">
        <article class="topic-card">
          <div class="card-body">
            <p class="card-tag">01 / Clarity</p>
            <h3>Simple explanations</h3>
            <p>
              Understand the science without needing a science degree.
            </p>
          </div>
        </article>

        <article class="topic-card">
          <div class="card-body">
            <p class="card-tag">02 / Transparency</p>
            <h3>Honest information</h3>
            <p>
              Separate evidence from trends, and disclose commercial
              relationships when they exist.
            </p>
          </div>
        </article>

        <article class="topic-card">
          <div class="card-body">
            <p class="card-tag">03 / Confidence</p>
            <h3>No perfection standards</h3>
            <p>
              Healthy skin education should inform you, not make you
              feel like you need to change how you look.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="newsletter" id="newsletter">
      <div class="container">
        <p class="eyebrow">A little skin science in your inbox</p>
        <h2>Stay in the know.</h2>
        <p>
          Get new educational guides and ingredient explainers
          when they're published.
        </p>

        <form class="newsletter-form" id="newsletterForm">
          <input
            type="email"
            id="email"
            placeholder="Your email address"
            aria-label="Your email address"
            required
          />
          <button class="button button-primary" type="submit">
            Keep me updated ↗
          </button>
        </form>

        <p class="form-note">
          No spam. Unsubscribe whenever you like.
        </p>
        <p class="form-message" id="formMessage" role="status"></p>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <div class="footer-top">
        <div>
          <div class="footer-brand">The Skin Edit.</div>
          <p class="footer-description">
            Skin science, simplified. Helping you make more informed
            skincare choices through accessible education.
          </p>
        </div>

        <div class="footer-links">
          <a href="#learn">Learn</a>
          <a href="#ingredients">Ingredients</a>
          <a href="#about">Our approach</a>
          <a href="#newsletter">Updates</a>
        </div>
      </div>

      <div class="footer-bottom">
        <span>© <span id="year"></span> The Skin Edit</span>
        <span>
          Educational content only — not a diagnosis or substitute
          for advice from a qualified health professional.
        </span>
      </div>
    </div>
  </footer>

  <script>
    const menuToggle = document.getElementById("menuToggle");
    const navigation = document.getElementById("navigation");

    menuToggle.addEventListener("click", () => {
      const isOpen = navigation.classList.toggle("open");
      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.setAttribute(
        "aria-label",
        isOpen ? "Close navigation" : "Open navigation"
      );
      menuToggle.textContent = isOpen ? "×" : "☰";
    });

    navigation.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        navigation.classList.remove("open");
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", "Open navigation");
        menuToggle.textContent = "☰";
      });
    });

    document.getElementById("year").textContent =
      new Date().getFullYear();

    // This is a visual prototype only.
    // Connect a newsletter service before collecting real emails.
    document.getElementById("newsletterForm").addEventListener(
      "submit",
      (event) => {
        event.preventDefault();
        document.getElementById("formMessage").textContent =
          "Thanks for your interest! Email sign-ups aren't connected yet.";
      }
    );
  </script>
</body>
</html>
